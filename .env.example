# Safety: publishing remains off unless this is explicitly true.
PUBLISH_ENABLED=false
POST_LIMIT=10

# Bluesky
BLUESKY_SERVICE_URL=https://bsky.social
BLUESKY_IDENTIFIER=chi-bike-stations.bsky.social
BLUESKY_APP_PASSWORD=

# Database
DB_PATH=data/chicago-bikeshare-bot.sqlite3

# City of Chicago station source
SODA_URL=https://data.cityofchicago.org/resource/bbyy-e7gq.json
SODA_TIMEOUT_MS=30000
SODA_MAX_RETRIES=3
SODA_MIN_STATIONS=500

# Native Protomaps vector map rendering
PROTOMAPS_KEY=
# Optional compatible vector-source override (paint/layout expressions are ignored):
# PROTOMAPS_STYLE_URL=https://example.com/style.json
MAP_WIDTH=1080
MAP_HEIGHT=1350
# Keep the prepared announcement-card output at exactly 1080x1350.
MAP_PIXEL_RATIO=1
MAP_ZOOM=17
MAP_NIGHTLINE_ZOOM=17.5
MAP_RENDER_TIMEOUT_MS=75000
MAP_RENDER_MAX_ATTEMPTS=2
MAP_RENDER_RETRY_DELAY_MS=2000
OUTPUT_DIR=output

# Google Street View
STREETVIEW_ENABLED=false
GOOGLE_MAPS_API_KEY=
STREETVIEW_TIMEOUT_MS=10000
